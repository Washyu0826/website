# Public site URL (absolute, HTTPS in production). Used for metadata, OG images and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public client). Required unless DEMO_MODE=true.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used by /admin actions, the contact form and /api/cron/publish.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (Supabase Auth). Comma-separated list of emails allowed into /admin.
# Create these users in the Supabase dashboard (Authentication > Users) first.
ADMIN_EMAIL=

# Admin AI translation drafts (Claude API). Optional; the translate button is hidden without it.
ANTHROPIC_API_KEY=

# Contact form (Resend). CONTACT_FROM_EMAIL must belong to a verified Resend domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Hold the public site back while the content is still being written. `true` answers every public
# page with 503 and a holding note, and robots.txt refuses everything; /admin, its API and share
# links stay open. Unset it (and redeploy) to open the site.
SITE_LOCKED=
# The one way past that curtain: visit any page once with ?unlock=<this value> and it is remembered
# in a cookie. Leave empty and nobody gets past, including you.
SITE_UNLOCK=
# Scheduled publishing: Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/publish.
# Also used as the fallback salt when hashing contact-form IPs.
CRON_SECRET=
# Optional dedicated salt for contact-form IP hashing (falls back to CRON_SECRET).
CONTACT_HASH_SALT=

# Explicitly enable sample content locally. Ignored on production deployments (VERCEL_ENV=production).
DEMO_MODE=true

# Error monitoring (Sentry). Entirely opt-in: with no DSN the build skips the wrapper, the browser
# never downloads the SDK, and nothing else here is read. Set these only when you want reports.
NEXT_PUBLIC_SENTRY_DSN=
# Needed alongside a DSN so the build can upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only, never expose to the client. Without it the build still succeeds; stack traces
# just stay minified and read like `a.b.c is not a function`.
SENTRY_AUTH_TOKEN=

# Used only by `npm run db:types` after `npx supabase login`.
SUPABASE_PROJECT_ID=
